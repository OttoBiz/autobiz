# Copy to frontend/.env.local
#
# API base for browser fetches (sidebar refresh, chat, analytics).
# Leave NEXT_PUBLIC_BACKEND_URL empty to use same-origin /backend proxy (recommended for local dev).
# Set to http://localhost:8000 only if the backend is reachable from the browser at that URL.

# Browser-facing API root (optional; default: /backend → Next.js rewrite to BACKEND_URL)
NEXT_PUBLIC_BACKEND_URL=

# Server-side proxy target for /backend/* rewrites (required when NEXT_PUBLIC_BACKEND_URL is empty)
BACKEND_URL=http://localhost:8000
