  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "tsdown": "^0.15.7",
    "turbo": "^2.5.8"
  },
  "packageManager": "pnpm@10.18.3"
}
